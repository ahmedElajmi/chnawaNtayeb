# Copy this file to .env (never commit .env) and replace every value.

# GEMINI_API_KEY: Required for the fridge photo scanner (Gemini Vision).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Required in production — the public URL where the app is hosted.
# It is the only source of the canonical, sitemap and robots URLs; the server
# refuses to start in production without it (request headers are never trusted).
APP_URL="https://your-app.onrender.com"

# ---------------------------------------------------------------------------
# /patron backoffice access
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD: required, at least 12 characters, never a value seen in the
# git history. If missing or too weak, the /patron login is disabled.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-long-unique-password"

# ADMIN_SESSION_SECRET: random string of at least 32 characters used to sign
# patron session tokens. Changing it logs every patron session out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# ---------------------------------------------------------------------------
# Firebase Admin (lets the /patron session write to Firestore)
# ---------------------------------------------------------------------------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line, or its base64 encoding. Without it, the
# backoffice works in "local only" mode (changes are not published).
FIREBASE_SERVICE_ACCOUNT=""
